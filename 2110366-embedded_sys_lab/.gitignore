**/Core/*
!**/Core/Src/
**/Core/Src/*
!**/Core/Src/main.c
**/.project
**/.cproject
**/.mxproject
**/*.launch
**/*.ld

# Generated OpenOCD launch configurations and ST-LINK logs
* Debug.cfg
* Release.cfg
*_gdbserver_log.txt

# Generated build artifacts
*.o
*.d
*.elf
*.hex
*.bin
*.map
*.list
*.su
*.cyclo
*.size.stdout

# OS-generated files
.DS_Store
Thumbs.db
